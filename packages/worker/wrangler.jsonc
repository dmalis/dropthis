{
  // Repo template for the Deploy-button path: bindings by NAME, no ids.
  // Never deployed from directly — `scripts/deploy-dev.mjs` (and later
  // `dropthis init`) render a per-instance config with the reconciled ids.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dropthis",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  // Client ID Metadata Documents (how claude.ai identifies itself) make the
  // Worker fetch a URL a client named; this flag is Cloudflare's SSRF guard
  // for that fetch, and the OAuth provider refuses CIMD without it.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "dropthis-drops" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }]
}
